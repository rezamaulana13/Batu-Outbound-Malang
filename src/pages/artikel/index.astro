---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import WhatsAppCTA from '../../components/WhatsAppCTA.astro';
import { getArticles, articleUrl, formatDate } from '../../lib/content';
import { waMessages } from '../../data/site';

const articles = await getArticles();
const featured = articles.find((a) => a.data.featured) ?? articles[0];
const restArticles = articles.filter((a) => a.id !== featured?.id);

const categories = ['Semua', 'Panduan outbound', 'Ide gathering', 'Tips keselamatan'];

// Menghitung jumlah artikel per kategori
const categoryCounts = categories.reduce((acc, cat) => {
  acc[cat] = cat === 'Semua' ? articles.length : articles.filter((a) => a.data.category === cat).length;
  return acc;
}, {} as Record<string, number>);

const itemList = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Panduan & Artikel Outbound Batu Malang',
  description: 'Panduan memilih paket outbound, rekomendasi lokasi, contoh rundown, dan tips persiapan gathering atau team building di Batu Malang.',
  url: new URL('/artikel/', Astro.site).href,
};

const breadcrumbs = [
  { label: 'Beranda', href: '/' },
  { label: 'Artikel & Panduan' },
];
---

<BaseLayout
  title="Artikel, Panduan & Tips Outbound Batu Malang | Batu Outbound Malang"
  description="Kumpulan panduan praktis perencanaan outbound di Batu Malang: rekomendasi lokasi terbaik, tips gathering kantor, simulasi anggaran, dan SOP keselamatan."
  path="/artikel/"
  breadcrumbs={breadcrumbs}
  schema={[itemList]}
>
  <!-- Hero Banner: Bersih, Rapi & Elegan -->
  <section class="page-hero">
    <div class="container text-center">
      <h1>Panduan & Inspirasi Outbound Batu Malang</h1>
      <p class="lead">
        Tulisan praktis dan wawasan mendalam untuk membantu Anda merencanakan kegiatan kelompok: mulai dari pemilihan venue, taktik team building, hingga SOP keselamatan.
      </p>
      <Breadcrumbs items={breadcrumbs} />

      <div class="btn-row" style="margin-top: 22px; justify-content: center;">
        <WhatsAppCTA label="Konsultasi Perencanaan Acara" message={waMessages.general} source="artikel-hero" />
        <a href="#daftar-artikel" class="btn btn--secondary">Jelajahi Artikel ↓</a>
      </div>
    </div>
  </section>

  <!-- Section Utama Artikel & Filter Kategori -->
  <section id="daftar-artikel" class="section article-section" aria-labelledby="h-artikel">
    <div class="container">
      <!-- Header Section Full Tengah -->
      <div class="art-header-center">
        <h2 id="h-artikel" class="art-title-center">Koleksi Tulisan & Tips Praktis</h2>
        <p class="art-desc-center">
          Pilih topik yang Anda butuhkan untuk mempermudah koordinasi panitia dan memastikan acara berjalan lancar.
        </p>
      </div>

      <!-- Filter Kategori Pas di Tengah -->
      <nav class="article-filter-wrap" aria-label="Filter kategori artikel">
        <div class="filter-pills-row" data-article-filters>
          {categories.map((cat, i) => (
            <button
              type="button"
              class={`filter-pill ${i === 0 ? 'is-active' : ''}`}
              data-filter={cat}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              <span>{cat}</span>
              <span class="pill-count">{categoryCounts[cat] || 0}</span>
            </button>
          ))}
        </div>
      </nav>

      <!-- Artikel Pilihan Utama (Featured Article Hero Card) -->
      {featured && (
        <div class="featured-article-wrap" data-category={featured.data.category}>
          <article class="featured-card">
            <div class="featured-media">
              <img
                src={featured.data.image || '/destinasi/coban-rondo.webp'}
                alt={featured.data.imageAlt || featured.data.title}
                loading="eager"
                decoding="async"
                width="800"
                height="500"
                class="featured-img"
              />
              <span class="badge-featured-label">Artikel Utama</span>
            </div>
            <div class="featured-body">
              <div class="featured-meta-top">
                <span class="badge-cat-pill">{featured.data.category}</span>
                <span class="meta-read-time">{featured.data.readingMinutes || 5} menit baca</span>
              </div>
              <h3 class="featured-title">
                <a href={articleUrl(featured.id)}>{featured.data.title}</a>
              </h3>
              <p class="featured-desc">{featured.data.description}</p>
              <div class="featured-foot">
                <div class="author-info">
                  <span class="author-name">{featured.data.author}</span>
                  <time class="publish-date" datetime={featured.data.publishDate.toISOString().slice(0, 10)}>
                    {formatDate(featured.data.publishDate)}
                  </time>
                </div>
                <a href={articleUrl(featured.id)} class="btn btn--primary btn-read-featured">
                  Baca Panduan Lengkap →
                </a>
              </div>
            </div>
          </article>
        </div>
      )}

      <!-- Grid Daftar Artikel Reguler -->
      <div class="article-grid" id="articles-container">
        {restArticles.map((art) => (
          <article class="art-card" data-category={art.data.category}>
            <div class="art-thumb-wrap">
              <img
                src={art.data.image || '/background-hero.webp'}
                alt={art.data.imageAlt || art.data.title}
                loading="lazy"
                decoding="async"
                width="600"
                height="400"
                class="art-img"
              />
              <span class="art-badge-cat">{art.data.category}</span>
            </div>
            <div class="art-body">
              <div class="art-meta">
                <time datetime={art.data.publishDate.toISOString().slice(0, 10)}>
                  {formatDate(art.data.publishDate)}
                </time>
                {art.data.readingMinutes && <span> · {art.data.readingMinutes} mnt baca</span>}
              </div>
              <h3 class="art-title">
                <a href={articleUrl(art.id)}>{art.data.title}</a>
              </h3>
              <p class="art-desc">{art.data.description}</p>
              <div class="art-foot">
                <span class="art-author">{art.data.author}</span>
                <a href={articleUrl(art.id)} class="art-link">
                  Baca artikel →
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Band Konsultasi -->
  <CtaBand
    title="Butuh Rekomendasi Rundown & Anggaran Outbound?"
    text="Diskusikan rencana kegiatan gathering, outbound, atau petualangan rombongan Anda bersama konsultan kami via WhatsApp."
    label="Konsultasi & Minta Proposal Gratis"
    source="artikel-daftar-bawah"
  />
</BaseLayout>

<!-- Client Side Script: Filter Kategori Artikel Cepat -->
<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('[data-article-filters] .filter-pill');
  const cards = document.querySelectorAll<HTMLElement>('#articles-container .art-card');
  const featuredBox = document.querySelector<HTMLElement>('.featured-article-wrap');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const selected = btn.getAttribute('data-filter') || 'Semua';

      // Update active state
      filterBtns.forEach((b) => {
        b.classList.remove('is-active');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('is-active');
      btn.setAttribute('aria-pressed', 'true');

      // Filter featured
      if (featuredBox) {
        const featCat = featuredBox.getAttribute('data-category');
        featuredBox.style.display = (selected === 'Semua' || featCat === selected) ? 'block' : 'none';
      }

      // Filter grid cards
      cards.forEach((card) => {
        const cat = card.getAttribute('data-category');
        if (selected === 'Semua' || cat === selected) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>

<style>
  /* Page Hero Centered */
  .page-hero {
    text-align: center;
  }
  .page-hero .lead {
    margin-left: auto;
    margin-right: auto;
    max-width: 720px;
  }

  /* Article Section */
  .article-section {
    padding: clamp(48px, 6vw, 80px) 0;
  }

  /* Header Section Full Tengah 100% Solid & Bersih */
  .art-header-center {
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
    text-align: center !important;
    margin: 0 auto 36px auto !important;
    width: 100% !important;
    max-width: 650px !important;
  }
  .art-title-center {
    color: #175c4c !important;
    font-family: var(--font-heading, 'Manrope', sans-serif) !important;
    font-size: clamp(2rem, 3.5vw, 2.75rem) !important;
    font-weight: 800 !important;
    line-height: 1.2 !important;
    letter-spacing: -0.02em !important;
    margin: 0 0 10px 0 !important;
    text-align: center !important;
    max-width: 620px !important;
    display: block !important;
    width: 100% !important;
  }
  .art-desc-center {
    color: var(--color-muted, #64748b) !important;
    font-size: 1rem !important;
    line-height: 1.6 !important;
    max-width: 580px !important;
    margin: 0 auto !important;
    text-align: center !important;
    display: block !important;
    width: 100% !important;
  }

  /* Filter Kategori Pas di Tengah */
  .article-filter-wrap {
    margin: 0 auto 40px auto;
    display: flex;
    justify-content: center;
  }
  .filter-pills-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
    padding: 4px;
    background: #f1f5f2;
    border-radius: 9999px;
    border: 1px solid #d9e4dc;
  }
  .filter-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 18px;
    border-radius: 9999px;
    background: transparent;
    border: none;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-ink);
    cursor: pointer;
    transition: all 0.2s ease;
    user-select: none;
  }
  .filter-pill:hover {
    color: #175c4c;
    background: rgba(255, 255, 255, 0.6);
  }
  .filter-pill.is-active {
    background: #175c4c;
    color: #ffffff;
    box-shadow: 0 2px 8px rgba(23, 92, 76, 0.25);
  }
  .pill-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 20px;
    padding: 0 6px;
    border-radius: 10px;
    font-size: 0.75rem;
    font-weight: 800;
    background: rgba(0, 0, 0, 0.08);
    color: inherit;
  }
  .filter-pill.is-active .pill-count {
    background: rgba(255, 255, 255, 0.25);
    color: #ffffff;
  }

  /* Featured Article Card (Highlight 2 Kolom) */
  .featured-article-wrap {
    margin-bottom: 48px;
  }
  .featured-card {
    display: grid;
    grid-template-columns: 1fr;
    background: #ffffff;
    border: 1px solid #c9d8ce;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(24, 34, 48, 0.06);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  @media (min-width: 860px) {
    .featured-card {
      grid-template-columns: 1.1fr 1.3fr;
    }
  }
  .featured-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(23, 92, 76, 0.12);
  }
  .featured-media {
    position: relative;
    min-height: 260px;
    overflow: hidden;
    background: #e2e8f0;
  }
  .featured-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .featured-card:hover .featured-img {
    transform: scale(1.05);
  }
  .badge-featured-label {
    position: absolute;
    top: 14px;
    left: 14px;
    background: var(--color-primary);
    color: var(--color-ink);
    font-size: 0.75rem;
    font-weight: 800;
    padding: 4px 12px;
    border-radius: 9999px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }
  .featured-body {
    padding: clamp(24px, 4vw, 36px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .featured-meta-top {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }
  .badge-cat-pill {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 9999px;
    background: #edf6f0;
    color: #175c4c;
    font-size: 0.8125rem;
    font-weight: 700;
  }
  .meta-read-time {
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
  .featured-title {
    font-size: clamp(1.35rem, 2.5vw, 1.85rem);
    font-weight: 800;
    line-height: 1.3;
    margin: 0 0 12px 0;
  }
  .featured-title a {
    color: var(--color-ink);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .featured-title a:hover {
    color: #175c4c;
  }
  .featured-desc {
    font-size: 1rem;
    color: var(--color-muted);
    line-height: 1.6;
    margin: 0 0 24px 0;
    flex-grow: 1;
  }
  .featured-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding-top: 18px;
    border-top: 1px solid var(--color-border);
  }
  .author-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
  .btn-read-featured {
    padding: 8px 18px;
    font-size: 0.875rem;
    white-space: nowrap;
  }

  /* Grid Artikel Reguler */
  .article-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
  }
  @media (min-width: 640px) {
    .article-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .article-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Article Card */
  .art-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(24, 34, 48, 0.05);
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .art-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 28px rgba(24, 34, 48, 0.1);
    border-color: #a7cfb5;
  }
  .art-thumb-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #e2e8f0;
  }
  .art-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .art-card:hover .art-img {
    transform: scale(1.06);
  }
  .art-badge-cat {
    position: absolute;
    top: 12px;
    left: 12px;
    background: rgba(23, 92, 76, 0.9);
    backdrop-filter: blur(4px);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 9999px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
  }
  .art-body {
    padding: 20px 22px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  .art-meta {
    font-size: 0.8125rem;
    color: var(--color-muted);
    margin-bottom: 8px;
  }
  .art-title {
    font-size: 1.15rem;
    font-weight: 800;
    line-height: 1.35;
    margin: 0 0 10px 0;
  }
  .art-title a {
    color: var(--color-ink);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .art-title a:hover {
    color: #175c4c;
  }
  .art-desc {
    font-size: 0.875rem;
    color: var(--color-muted);
    line-height: 1.6;
    margin: 0 0 16px 0;
    flex-grow: 1;
  }
  .art-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 14px;
    border-top: 1px solid var(--color-border);
    font-size: 0.8125rem;
  }
  .art-author {
    color: var(--color-muted);
    font-weight: 600;
  }
  .art-link {
    font-weight: 700;
    color: #175c4c;
    text-decoration: none;
    transition: transform 0.15s ease;
  }
  .art-link:hover {
    text-decoration: underline;
    transform: translateX(2px);
  }
</style>
