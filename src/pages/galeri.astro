---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBand from '../components/CtaBand.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';
import { gallery, galleryCategories } from '../data/gallery';
import { site } from '../data/site';

const breadcrumbs = [
  { label: 'Beranda', href: '/' },
  { label: 'Galeri Kegiatan' },
];

// Menghitung jumlah item per kategori untuk badge filter
const categoryCounts = galleryCategories.reduce((acc, cat) => {
  acc[cat] = cat === 'Semua' ? gallery.length : gallery.filter((g) => g.category === cat).length;
  return acc;
}, {} as Record<string, number>);
---

<BaseLayout
  title="Galeri Dokumentasi Outbound di Batu Malang | Batu Outbound Malang"
  description="Koleksi foto otentik kegiatan outbound, team building, arung jeram rafting, offroad jeep 4x4, paintball, dan family gathering di venue terbaik Kota Batu Malang."
  path="/galeri/"
  breadcrumbs={breadcrumbs}
>
  <!-- Hero Banner: Bersih, Rapi & Elegan -->
  <section class="page-hero">
    <div class="container text-center">
      <h1>Galeri Dokumentasi Outbound Batu Malang</h1>
      <p class="lead">
        Momen nyata keseruan, kekompakan tim, dan petualangan di alam bebas pegunungan sejuk Kota Wisata Batu dan Malang.
      </p>
      <Breadcrumbs items={breadcrumbs} />

      <div class="btn-row" style="margin-top: 22px; justify-content: center;">
        <WhatsAppCTA label="Konsultasi Dokumentasi Acara" message="Halo Admin Batu Outbound Malang, saya ingin konsultasi rencana kegiatan outbound dan dokumentasi foto/video untuk rombongan kami." source="galeri-hero" />
        <a href="#koleksi-foto" class="btn btn--secondary">Lihat Koleksi Foto ↓</a>
      </div>
    </div>
  </section>

  <!-- Section Utama Galeri & Filter Interaktif -->
  <section id="koleksi-foto" class="section gallery-section" aria-labelledby="h-foto">
    <div class="container">
      <!-- Header Section Full Tengah -->
      <div class="gal-header-center">
        <h2 id="h-foto" class="gal-title-center">Dokumentasi Momen Terbaik di Lapangan</h2>
        <p class="gal-desc-center">
          Pilih kategori di bawah untuk menyaring foto kegiatan sesuai jenis paket yang sedang Anda rencanakan.
        </p>
      </div>

      <!-- Filter Kategori Pas di Tengah -->
      <nav class="gallery-filter-wrap" aria-label="Filter kategori galeri">
        <div class="filter-pills-row" data-gallery-filters>
          {galleryCategories.map((cat, i) => (
            <button
              type="button"
              class={`filter-pill ${i === 0 ? 'is-active' : ''}`}
              data-filter={cat}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              <span>{cat}</span>
              <span class="pill-count">{categoryCounts[cat]}</span>
            </button>
          ))}
        </div>
      </nav>

      <!-- Grid Foto Galeri Modern -->
      <div class="gallery-grid" id="gallery-container">
        {gallery.map((item, idx) => (
          <article
            class="gallery-card"
            data-category={item.category}
            data-idx={idx}
            tabindex="0"
            role="button"
            aria-label={`Buka foto: ${item.title}`}
          >
            <div class="gallery-thumb-box">
              <img
                src={item.src}
                alt={item.alt}
                width={item.width || 800}
                height={item.height || 600}
                loading="lazy"
                decoding="async"
                class="gallery-img"
              />
              <div class="gallery-badges">
                <span class="badge-cat">{item.category}</span>
                <span class="badge-loc">{item.location.split(',')[0]}</span>
              </div>
              <div class="gallery-overlay">
                <span class="zoom-trigger">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    <line x1="11" y1="8" x2="11" y2="14"></line>
                    <line x1="8" y1="11" x2="14" y2="11"></line>
                  </svg>
                  Perbesar Foto
                </span>
              </div>
            </div>
            <div class="gallery-info">
              <h3 class="gallery-title">{item.title}</h3>
              <p class="gallery-caption">{item.caption}</p>
              {item.tags && (
                <div class="gallery-tags">
                  {item.tags.slice(0, 3).map((tag) => (
                    <span class="tag-chip">#{tag}</span>
                  ))}
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Interactive Lightbox Modal -->
  <div id="lightbox-modal" class="lightbox-modal" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="lightbox-backdrop" id="lightbox-backdrop"></div>
    <div class="lightbox-dialog">
      <button type="button" class="lightbox-close" id="lightbox-close-btn" aria-label="Tutup foto perbesar">✕</button>

      <button type="button" class="lightbox-nav lightbox-prev" id="lightbox-prev-btn" aria-label="Foto sebelumnya">❮</button>
      <button type="button" class="lightbox-nav lightbox-next" id="lightbox-next-btn" aria-label="Foto selanjutnya">❯</button>

      <div class="lightbox-body">
        <div class="lightbox-media-wrap">
          <img id="lightbox-img" src="" alt="" class="lightbox-img" />
        </div>
        <div class="lightbox-info-pane">
          <div class="lightbox-meta">
            <span id="lightbox-cat" class="badge-cat"></span>
            <span id="lightbox-loc" class="lightbox-loc-text"></span>
          </div>
          <h3 id="lightbox-title" class="lightbox-title"></h3>
          <p id="lightbox-desc" class="lightbox-desc"></p>
          <div class="lightbox-cta-row">
            <a id="lightbox-wa-btn" href="#" target="_blank" rel="noopener noreferrer" class="btn btn--primary">
              Tanya Paket Sesuai Foto Ini
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <CtaBand
    title="Siap Mengabadikan Momen Bersejarah Rombongan Anda?"
    text="Konsultasikan tanggal kegiatan, lokasi favorit, dan kebutuhan fasilitas dokumentasi bersama konsultan acara kami."
    label="Konsultasi & Penawaran Gratis"
    source="galeri-bawah"
  />
</BaseLayout>

<!-- Client Side Script: Filter Kategori & Lightbox Modal Interaktif -->
<script define:vars={{ galleryItems: gallery, phone: site.whatsappNumber }}>
  // Data galeri dari server
  const items = galleryItems;
  let activeIndex = 0;
  let visibleIndices = items.map((_, i) => i);

  // Filter Kategori
  const filterBtns = document.querySelectorAll('[data-gallery-filters] .filter-pill');
  const cards = document.querySelectorAll('#gallery-container .gallery-card');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const selected = btn.getAttribute('data-filter') || 'Semua';

      // Update state tombol filter
      filterBtns.forEach((b) => {
        b.classList.remove('is-active');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('is-active');
      btn.setAttribute('aria-pressed', 'true');

      // Filter kartu galeri
      visibleIndices = [];
      cards.forEach((card, idx) => {
        const cat = card.getAttribute('data-category');
        if (selected === 'Semua' || cat === selected) {
          card.classList.remove('is-hidden');
          visibleIndices.push(idx);
        } else {
          card.classList.add('is-hidden');
        }
      });
    });
  });

  // Lightbox Modal Logic
  const modal = document.getElementById('lightbox-modal');
  const backdrop = document.getElementById('lightbox-backdrop');
  const closeBtn = document.getElementById('lightbox-close-btn');
  const prevBtn = document.getElementById('lightbox-prev-btn');
  const nextBtn = document.getElementById('lightbox-next-btn');

  const lbImg = document.getElementById('lightbox-img');
  const lbCat = document.getElementById('lightbox-cat');
  const lbLoc = document.getElementById('lightbox-loc');
  const lbTitle = document.getElementById('lightbox-title');
  const lbDesc = document.getElementById('lightbox-desc');
  const lbWaBtn = document.getElementById('lightbox-wa-btn');

  function openLightbox(index) {
    activeIndex = index;
    const data = items[index];
    if (!data) return;

    lbImg.src = data.src;
    lbImg.alt = data.alt || data.title;
    lbCat.textContent = data.category;
    lbLoc.textContent = data.location;
    lbTitle.textContent = data.title;
    lbDesc.textContent = data.caption;

    // Direct WhatsApp message link
    const waText = encodeURIComponent(
      `Halo Admin Batu Outbound Malang, saya tertarik dengan kegiatan "${data.title}" di ${data.location}. Boleh minta informasi rincian paket dan estimasi biayanya?`
    );
    lbWaBtn.href = `https://wa.me/${phone}?text=${waText}`;

    modal.classList.add('is-open');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  function showNext() {
    const currentPos = visibleIndices.indexOf(activeIndex);
    if (currentPos === -1) return;
    const nextPos = (currentPos + 1) % visibleIndices.length;
    openLightbox(visibleIndices[nextPos]);
  }

  function showPrev() {
    const currentPos = visibleIndices.indexOf(activeIndex);
    if (currentPos === -1) return;
    const prevPos = (currentPos - 1 + visibleIndices.length) % visibleIndices.length;
    openLightbox(visibleIndices[prevPos]);
  }

  // Event Listeners pada kartu galeri
  cards.forEach((card) => {
    card.addEventListener('click', () => {
      const idx = parseInt(card.getAttribute('data-idx') || '0', 10);
      openLightbox(idx);
    });
    card.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        const idx = parseInt(card.getAttribute('data-idx') || '0', 10);
        openLightbox(idx);
      }
    });
  });

  // Tombol navigasi lightbox
  if (closeBtn) closeBtn.addEventListener('click', closeLightbox);
  if (backdrop) backdrop.addEventListener('click', closeLightbox);
  if (prevBtn) prevBtn.addEventListener('click', showPrev);
  if (nextBtn) nextBtn.addEventListener('click', showNext);

  // Keyboard navigation
  window.addEventListener('keydown', (e) => {
    if (!modal.classList.contains('is-open')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowRight') showNext();
    if (e.key === 'ArrowLeft') showPrev();
  });
</script>

<style>
  /* Page Hero Centered */
  .page-hero {
    text-align: center;
  }
  .page-hero .lead {
    margin-left: auto;
    margin-right: auto;
    max-width: 720px;
  }

  /* Gallery Section */
  .gallery-section {
    padding: clamp(48px, 6vw, 80px) 0;
  }

  /* Header Section Full Tengah 100% Solid & Bersih */
  .gal-header-center {
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
    text-align: center !important;
    margin: 0 auto 36px auto !important;
    width: 100% !important;
    max-width: 650px !important;
  }
  .gal-title-center {
    color: #175c4c !important;
    font-family: var(--font-heading, 'Manrope', sans-serif) !important;
    font-size: clamp(2rem, 3.5vw, 2.75rem) !important;
    font-weight: 800 !important;
    line-height: 1.2 !important;
    letter-spacing: -0.02em !important;
    margin: 0 0 10px 0 !important;
    text-align: center !important;
    max-width: 620px !important;
    display: block !important;
    width: 100% !important;
  }
  .gal-desc-center {
    color: var(--color-muted, #64748b) !important;
    font-size: 1rem !important;
    line-height: 1.6 !important;
    max-width: 580px !important;
    margin: 0 auto !important;
    text-align: center !important;
    display: block !important;
    width: 100% !important;
  }

  /* Filter Kategori Pas di Tengah */
  .gallery-filter-wrap {
    margin: 0 auto 36px auto;
    display: flex;
    justify-content: center;
  }
  .filter-pills-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
    padding: 4px;
    background: #f1f5f2;
    border-radius: 9999px;
    border: 1px solid #d9e4dc;
  }
  .filter-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 18px;
    border-radius: 9999px;
    background: transparent;
    border: none;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-ink);
    cursor: pointer;
    transition: all 0.2s ease;
    user-select: none;
  }
  .filter-pill:hover {
    color: #175c4c;
    background: rgba(255, 255, 255, 0.6);
  }
  .filter-pill.is-active {
    background: #175c4c;
    color: #ffffff;
    box-shadow: 0 2px 8px rgba(23, 92, 76, 0.25);
  }
  .pill-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 20px;
    padding: 0 6px;
    border-radius: 10px;
    font-size: 0.75rem;
    font-weight: 800;
    background: rgba(0, 0, 0, 0.08);
    color: inherit;
  }
  .filter-pill.is-active .pill-count {
    background: rgba(255, 255, 255, 0.25);
    color: #ffffff;
  }

  /* Gallery Grid */
  .gallery-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }
  @media (min-width: 640px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .gallery-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 28px;
    }
  }

  /* Gallery Card */
  .gallery-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(24, 34, 48, 0.05);
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    cursor: pointer;
    display: flex;
    flex-direction: column;
  }
  .gallery-card:hover,
  .gallery-card:focus-visible {
    transform: translateY(-4px);
    box-shadow: 0 10px 28px rgba(24, 34, 48, 0.1);
    border-color: #a7cfb5;
    outline: none;
  }
  .gallery-card.is-hidden {
    display: none !important;
  }

  /* Thumbnail Box */
  .gallery-thumb-box {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #e2e8f0;
  }
  .gallery-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .gallery-card:hover .gallery-img {
    transform: scale(1.06);
  }

  /* Badges */
  .gallery-badges {
    position: absolute;
    top: 12px;
    left: 12px;
    right: 12px;
    display: flex;
    justify-content: space-between;
    gap: 8px;
    z-index: 2;
    pointer-events: none;
  }
  .badge-cat {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 9999px;
    background: rgba(23, 92, 76, 0.9);
    backdrop-filter: blur(4px);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
  }
  .badge-loc {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 9999px;
    background: rgba(24, 34, 48, 0.85);
    backdrop-filter: blur(4px);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 600;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
  }

  /* Overlay */
  .gallery-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(23, 92, 76, 0.2) 0%, rgba(15, 23, 42, 0.75) 100%);
    opacity: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.25s ease;
    z-index: 3;
  }
  .gallery-card:hover .gallery-overlay {
    opacity: 1;
  }
  .zoom-trigger {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    background: rgba(255, 255, 255, 0.95);
    color: #175c4c;
    font-size: 0.875rem;
    font-weight: 700;
    border-radius: 9999px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.3);
    transform: translateY(8px);
    transition: transform 0.25s ease;
  }
  .gallery-card:hover .zoom-trigger {
    transform: translateY(0);
  }

  /* Card Info Content */
  .gallery-info {
    padding: 18px 20px 20px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  .gallery-title {
    font-size: 1.0625rem;
    font-weight: 800;
    color: var(--color-ink);
    margin: 0 0 8px 0;
    line-height: 1.35;
  }
  .gallery-caption {
    font-size: 0.875rem;
    color: var(--color-muted);
    line-height: 1.55;
    margin: 0 0 14px 0;
    flex-grow: 1;
  }
  .gallery-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tag-chip {
    font-size: 0.75rem;
    font-weight: 600;
    color: #2e6b4f;
    background: #edf6f0;
    padding: 2px 8px;
    border-radius: 4px;
  }

  /* Lightbox Modal */
  .lightbox-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }
  .lightbox-modal.is-open {
    opacity: 1;
    pointer-events: auto;
  }
  .lightbox-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(15, 23, 42, 0.92);
    backdrop-filter: blur(10px);
  }
  .lightbox-dialog {
    position: relative;
    z-index: 2;
    width: 92%;
    max-width: 980px;
    max-height: 92vh;
    background: #ffffff;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
    display: flex;
    flex-direction: column;
  }
  .lightbox-close {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 10;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(15, 23, 42, 0.7);
    color: #ffffff;
    border: none;
    font-size: 1.15rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .lightbox-close:hover {
    background: #e11d48;
    transform: scale(1.08);
  }
  .lightbox-nav {
    position: absolute;
    top: 40%;
    transform: translateY(-50%);
    z-index: 10;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(15, 23, 42, 0.7);
    color: #ffffff;
    border: none;
    font-size: 1.25rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .lightbox-nav:hover {
    background: #175c4c;
    transform: translateY(-50%) scale(1.1);
  }
  .lightbox-prev {
    left: 14px;
  }
  .lightbox-next {
    right: 14px;
  }

  .lightbox-body {
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    max-height: 92vh;
  }
  @media (min-width: 800px) {
    .lightbox-body {
      flex-direction: row;
    }
  }
  .lightbox-media-wrap {
    flex: 1.4;
    background: #0b1120;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 300px;
  }
  .lightbox-img {
    max-width: 100%;
    max-height: 65vh;
    object-fit: contain;
  }
  .lightbox-info-pane {
    flex: 1;
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: #ffffff;
  }
  .lightbox-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }
  .lightbox-loc-text {
    font-size: 0.8438rem;
    font-weight: 600;
    color: var(--color-muted);
  }
  .lightbox-title {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--color-ink);
    margin: 0 0 12px 0;
    line-height: 1.3;
  }
  .lightbox-desc {
    font-size: 0.9375rem;
    color: var(--color-muted);
    line-height: 1.6;
    margin: 0 0 24px 0;
  }
  .lightbox-cta-row {
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid var(--color-border);
  }
  .lightbox-cta-row a {
    width: 100%;
    text-align: center;
    justify-content: center;
  }
</style>
