---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';

const breadcrumbs = [
  { label: 'Beranda', href: '/' },
  { label: 'Profil' }
];

const aboutSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: `Tentang ${site.name}`,
  description: `Profil ${site.name}: Penyelenggara outbound, team building, dan family gathering profesional di Kota Wisata Batu dan Malang.`,
  url: new URL('/profil/', Astro.site ?? 'https://batuoutboundmalang.example').href,
};
---

<BaseLayout
  title={`Tentang Kami | Profil ${site.name}`}
  description={`Kenali ${site.name}: Provider & organizer outbound, family gathering, and team building terpercaya di Kota Batu – Malang dengan instruktur tersertifikasi.`}
  path="/profil/"
  breadcrumbs={breadcrumbs}
  schema={[aboutSchema]}
>
  <!-- Page Hero Banner with Background Image & Centered Breadcrumb -->
  <section class="page-hero">
    <div class="container">
      <h1>Tentang {site.name}</h1>
      <p class="lead">
        Partner Penyelenggara Outbound, Family Gathering, dan Team Building Profesional & Terpercaya di Kota Batu – Malang
      </p>
      <Breadcrumbs items={breadcrumbs} />
    </div>
  </section>

  <!-- Section: Siapa Kami (Detail tentang Batu Outbound Malang) -->
  <section class="section about-section" aria-labelledby="h-siapa-kami">
    <div class="container about-grid">
      <div class="about-image-col">
        <div class="about-img-frame">
          <img
            src="/tentang-kami.webp"
            alt="Keseruan kegiatan team building outbound di Batu Malang"
            class="about-img"
            loading="lazy"
            width="600"
            height="450"
          />
        </div>
      </div>

      <div class="about-content-col">
        <h2 id="h-siapa-kami" class="about-title">Siapa Kami</h2>
        
        <p class="about-text">
          <strong>Batu Outbound Malang</strong> adalah provider dan event organizer kegiatan luar ruang (outdoor activities) profesional yang berbasis di Kota Wisata Batu, Jawa Timur. Kami berfokus mendesain dan memfasilitasi program <em>experiential learning</em> modern untuk perusahaan swasta, BUMN, instansi kementerian, sekolah, universitas, hingga komunitas dan rombongan keluarga.
        </p>
        
        <p class="about-text">
          Mulai dari <strong>Company Gathering</strong> berskala besar, <strong>Team Building & Leadership Training</strong>, simulasi <strong>Fun Outbound Games</strong>, arung jeram (rafting), paintball taktis, hingga camping ground tematik. Kami mendampingi setiap fase kegiatan dengan pendekatan yang terstruktur, komunikatif, menyenangkan, aman, dan berorientasi pada pencapaian tujuan tim.
        </p>

        <p class="about-text">
          Dengan dukungan instruktur tersertifikasi BNSP dan jaringan kemitraan dengan 9+ destinasi wisata alam terbaik di Kota Batu, kami siap memberikan pengalaman kegiatan alam terbuka yang berkesan, tertata rapi, dan sesuai dengan alokasi anggaran Anda.
        </p>
      </div>
    </div>
  </section>

  <!-- Section: Visi & Misi Kami (Full Tengah) -->
  <section class="section section--tint vision-mission-section" aria-labelledby="h-visi-misi">
    <div class="container">
      <div class="section-head text-center">
        <h2 id="h-visi-misi" class="vm-title-center">Visi & Misi Kami</h2>
        <p class="vm-desc-center">
          Prinsip dasar dan komitmen kami dalam menghadirkan pengalaman outbound dan gathering terbaik di Batu–Malang.
        </p>
      </div>

      <div class="vm-grid">
        <!-- Card 1: Visi Kami (Dark Forest Green Background) -->
        <div class="vm-card vm-card--dark">
          <div class="vm-card__head">
            <span class="vm-pill">VISI KAMI</span>
            <h3>Visi Kami</h3>
          </div>
          <p class="vm-text-lead">
            Menjadi penyelenggara wisata edukasi, outbound training, dan employee gathering nomor 1 di Kota Batu dan Malang yang terpercaya, profesional, serta berstandar keselamatan tinggi.
          </p>
          <p class="vm-text-sub">
            Fokus kami adalah memberikan dampak positif berkelanjutan bagi penguatan karakter, kekompakan tim, serta sinergi kemajuan organisasi mitra dalam jangka panjang.
          </p>
        </div>

        <!-- Card 2: Misi Kami (Clean White Card with Green Checkmarks) -->
        <div class="vm-card vm-card--light">
          <div class="vm-card__head">
            <span class="vm-pill vm-pill--green">MISI KAMI</span>
            <h3>Misi Kami</h3>
          </div>
          <ul class="vm-check-list">
            <li>
              <div class="check-icon">
                <svg viewBox="0 0 20 20" fill="currentColor" width="18" height="18">
                  <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd"/>
                </svg>
              </div>
              <div>
                <strong>Program Terarah & Inovatif</strong>
                <span>Merancang modul kegiatan outbound yang adaptif, seru, dan relevan dengan visi & tujuan setiap klien.</span>
              </div>
            </li>
            <li>
              <div class="check-icon">
                <svg viewBox="0 0 20 20" fill="currentColor" width="18" height="18">
                  <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd"/>
                </svg>
              </div>
              <div>
                <strong>Fasilitator Berpengalaman</strong>
                <span>Menghadirkan master games dan instruktur lapangan yang ramah, komunikatif, dan tersertifikasi BNSP.</span>
              </div>
            </li>
            <li>
              <div class="check-icon">
                <svg viewBox="0 0 20 20" fill="currentColor" width="18" height="18">
                  <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd"/>
                </svg>
              </div>
              <div>
                <strong>Standar Keselamatan (Safety First)</strong>
                <span>Menegakkan SOP keselamatan kerja luar ruang yang ketat dengan peralatan berstandar dan tim medis P3K siaga.</span>
              </div>
            </li>
            <li>
              <div class="check-icon">
                <svg viewBox="0 0 20 20" fill="currentColor" width="18" height="18">
                  <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd"/>
                </svg>
              </div>
              <div>
                <strong>Transparansi & Harga Jujur</strong>
                <span>Memberikan rincian proposal penawaran harga yang transparan, jelas, dan fleksibel tanpa biaya tersembunyi.</span>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Section: Call To Action Full Tengah (Berlatar Belakang cta.webp) -->
  <CtaBand
    title="Siap Bangun Kebersamaan dan Kekompakan Tim Anda di Batu?"
    subtitle="Konsultasikan rencana kegiatan gathering atau outbound kantor Anda bersama tim Batu Outbound Malang. Dapatkan rekomendasi rundown dan penawaran terbaik gratis!"
    source="profil-page"
  />
</BaseLayout>

<style>
  /* Section Siapa Kami */
  .about-section {
    padding-top: 56px;
    padding-bottom: 56px;
  }
  .about-grid {
    display: grid;
    gap: 36px;
    align-items: center;
  }
  @media (min-width: 960px) {
    .about-grid {
      grid-template-columns: 1fr 1.15fr;
      gap: 52px;
    }
  }

  .about-img-frame {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(24, 34, 48, 0.12);
    border: 3px solid #ffffff;
  }
  .about-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    aspect-ratio: 4 / 3;
    transition: transform 0.4s ease;
  }
  .about-img-frame:hover .about-img {
    transform: scale(1.03);
  }

  .about-title {
    font-size: clamp(1.8rem, 3.2vw, 2.5rem);
    color: var(--color-ink);
    margin: 0 0 16px 0;
    line-height: 1.25;
  }
  .about-text {
    font-size: 1.0313rem;
    line-height: 1.8;
    color: var(--color-text);
    margin-bottom: 16px;
  }
  .about-text:last-of-type {
    margin-bottom: 0;
  }

  /* Section Visi & Misi (Full Tengah) */
  .vision-mission-section {
    padding-top: 60px;
    padding-bottom: 60px;
  }
  .section-head.text-center {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    margin-bottom: 36px;
  }
  .section-head.text-center h2,
  .section-head.text-center p {
    text-align: center;
    margin-inline: auto;
  }
  .vm-title-center {
    font-size: clamp(1.9rem, 3.5vw, 2.6rem);
    color: var(--color-ink);
    margin: 0 0 10px 0;
  }
  .vm-desc-center {
    font-size: 1.0625rem;
    color: var(--color-muted);
    max-width: 680px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .vm-grid {
    display: grid;
    gap: 28px;
    margin-top: 40px;
    max-width: 1040px;
    margin-inline: auto;
  }
  @media (min-width: 840px) {
    .vm-grid {
      grid-template-columns: 1fr 1fr;
      gap: 36px;
    }
  }

  .vm-card {
    border-radius: var(--radius-lg);
    padding: 34px 30px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    box-shadow: 0 6px 24px rgba(24, 34, 48, 0.07);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .vm-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(24, 34, 48, 0.12);
  }

  /* Visi: Dark Forest Green Card */
  .vm-card--dark {
    background: #143e2b;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .vm-card--dark h3 {
    font-size: 1.65rem;
    color: #ffffff;
    margin: 8px 0 16px 0;
  }
  .vm-pill {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 4px 10px;
    background: rgba(244, 180, 0, 0.2);
    color: var(--color-primary);
    border-radius: 9999px;
  }
  .vm-pill--green {
    background: var(--color-green-soft);
    color: var(--color-green);
  }
  .vm-text-lead {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.95);
    margin-bottom: 16px;
  }
  .vm-text-sub {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.8);
    margin: 0;
    padding-top: 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
  }

  /* Misi: Clean White Card with Checkmarks */
  .vm-card--light {
    background: #ffffff;
    border: 1px solid var(--color-border);
  }
  .vm-card--light h3 {
    font-size: 1.65rem;
    color: var(--color-ink);
    margin: 8px 0 18px 0;
  }
  .vm-check-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .vm-check-list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }
  .check-icon {
    flex-shrink: 0;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--color-green-soft);
    color: var(--color-green);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 2px;
  }
  .vm-check-list strong {
    display: block;
    font-size: 0.9688rem;
    color: var(--color-ink);
    margin-bottom: 2px;
  }
  .vm-check-list span {
    display: block;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-muted);
  }
</style>
