---
const { small = true } = Astro.props as { small?: boolean };
---
<img
  src="/logo-mark.webp"
  alt="Batu Outbound Malang"
  class="brand__mark"
  width={small ? 38 : 48}
  height={small ? 38 : 48}
  loading="eager"
  decoding="async"
/>

<style>
  .brand__mark {
    width: 40px;
    height: 40px;
    object-fit: contain;
    flex-shrink: 0;
    display: inline-block;
  }
</style>

