---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Halaman tidak ditemukan | Batu Outbound Malang" description="Halaman yang Anda cari tidak ditemukan." path="/404/" noindex>
  <section class="container notfound">
    <h1>Halaman tidak ditemukan</h1>
    <p class="lead" style="margin-inline:auto;">Alamat yang Anda buka mungkin salah ketik atau sudah dipindahkan. Coba mulai dari salah satu halaman di bawah.</p>
    <div class="btn-row">
      <a class="btn btn--primary" href="/">Ke beranda</a>
      <a class="btn btn--secondary" href="/paket/">Lihat paket outbound</a>
      <a class="btn btn--secondary" href="/destinasi/">Destinasi outbound</a>
      <a class="btn btn--secondary" href="/artikel/">Baca artikel</a>
    </div>
  </section>
</BaseLayout>
