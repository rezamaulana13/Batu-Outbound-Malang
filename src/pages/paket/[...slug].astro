---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Faq from '../../components/Faq.astro';
import PackageCard from '../../components/PackageCard.astro';
import WhatsAppCTA from '../../components/WhatsAppCTA.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import { render } from 'astro:content';
import { getPackages, pkgUrl, categoryLabel, formatRupiah } from '../../lib/content';
import { waMessages, site } from '../../data/site';

export async function getStaticPaths() {
  const packages = await getPackages();
  return packages.map((pkg) => ({ params: { slug: pkg.id }, props: { pkg, all: packages } }));
}

const { pkg, all } = Astro.props;
const d = pkg.data;
const { Content } = await render(pkg);
const related = (d.related.length ? all.filter((p) => d.related.includes(p.id)) : all.filter((p) => p.id !== pkg.id)).slice(0, 3);
const otherPackages = all.filter((p) => p.id !== pkg.id);
const msg = waMessages.pkg(d.title);
const base = Astro.site!;

const service: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: d.title,
  description: d.description,
  serviceType: categoryLabel[d.category],
  areaServed: site.serviceAreas,
  provider: { '@id': new URL('/#organization', base).href },
  url: new URL(pkgUrl(pkg.id), base).href,
};
if (d.priceFrom) {
  service.offers = {
    '@type': 'Offer',
    priceCurrency: 'IDR',
    price: d.priceFrom,
    ...(d.priceValidUntil ? { priceValidUntil: d.priceValidUntil } : {}),
  };
}
const breadcrumbs = [
  { label: 'Beranda', href: '/' },
  { label: 'Paket Outbound', href: '/paket/' },
  { label: d.title },
];
---
<BaseLayout
  title={`${d.title} | Batu Outbound Malang`}
  description={d.description}
  path={pkgUrl(pkg.id)}
  image={d.image}
  modified={d.updatedDate}
  breadcrumbs={breadcrumbs}
  schema={[service]}
  waMessage={msg}
>
  <!-- Hero Banner: Bersih, Terpusat, Tanpa Badge Mengambang di Pojok -->
  <section class="page-hero">
    <div class="container">
      <h1>{d.title}</h1>
      <p class="lead">{d.description}</p>
      <Breadcrumbs items={breadcrumbs} />
      <div class="btn-row" style="margin-top:20px;">
        <WhatsAppCTA label={`Tanyakan ${d.title}`} message={msg} source={pkg.id} />
        <a href="/paket/" class="btn btn--secondary">Lihat Semua Paket</a>
      </div>
    </div>
  </section>

  <!-- Konten Utama Detail Paket dengan Jarak Ideal dari Hero -->
  <div class="container" style="padding-top: clamp(44px, 5vw, 68px); padding-bottom: clamp(56px, 6vw, 80px);">
    <div class="pkg-detail-layout">
      <!-- Kolom Konten Kiri (Main) -->
      <main class="pkg-detail-main">
        <!-- Banner Foto Utama & Caption -->
        <figure class="pkg-main-media">
          <div class="pkg-main-img-wrap">
            <img
              src={d.image ?? '/destinasi/coban-rondo.webp'}
              alt={`Dokumentasi kegiatan ${d.title} di kawasan wisata Batu Malang`}
              class="pkg-main-img"
              width="900"
              height="500"
            />
            <span class="pkg-media-badge">{categoryLabel[d.category]}</span>
          </div>
          <figcaption class="pkg-img-caption">
            Dokumentasi simulasi dan kegiatan interaktif {d.title} di kawasan sejuk Kota Batu Malang
          </figcaption>
        </figure>

        <!-- Section 1: Gambaran & Ulasan Paket -->
        <section class="pkg-section-block" aria-labelledby="h-tentang">
          <h2 id="h-tentang" class="pkg-block-title">Tentang {d.title}</h2>
          <div class="pkg-text-content">
            <Content />
          </div>
        </section>

        <!-- Section 2: Sasaran Peserta & Capaian Program -->
        <section class="pkg-section-block" aria-labelledby="h-sasaran">
          <h2 id="h-sasaran" class="pkg-block-title">Sasaran Peserta & Capaian Program</h2>
          <div class="pkg-two-cards">
            <div class="pkg-card-box">
              <h3 class="pkg-box-title">
                <svg viewBox="0 0 20 20" fill="currentColor" width="20" height="20" class="icon-accent">
                  <path d="M10 9a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm-7 9a7 7 0 1 1 14 0H3Z"/>
                </svg>
                Cocok Untuk Siapa?
              </h3>
              <ul class="pkg-custom-list">
                {d.suitableFor.map((s) => (
                  <li>
                    <span class="bullet-check">✓</span>
                    <span>{s}</span>
                  </li>
                ))}
              </ul>
            </div>

            {d.goals.length > 0 && (
              <div class="pkg-card-box">
                <h3 class="pkg-box-title">
                  <svg viewBox="0 0 20 20" fill="currentColor" width="20" height="20" class="icon-accent">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd"/>
                  </svg>
                  Tujuan & Nilai yang Didapat
                </h3>
                <ul class="pkg-custom-list">
                  {d.goals.map((g) => (
                    <li>
                      <span class="bullet-check">✓</span>
                      <span>{g}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </section>

        <!-- Section 3: Rincian Fasilitas Paket (Included & Excluded) -->
        <section class="pkg-section-block" aria-labelledby="h-fasilitas">
          <h2 id="h-fasilitas" class="pkg-block-title">Rincian Fasilitas Paket</h2>
          <div class="pkg-two-cards">
            <div class="pkg-card-box pkg-card-box--green">
              <div class="box-badge-head box-badge-head--green">
                <svg viewBox="0 0 20 20" fill="currentColor" width="18" height="18">
                  <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd"/>
                </svg>
                Fasilitas Sudah Termasuk (Included)
              </div>
              <ul class="pkg-custom-list">
                {d.included.map((x) => (
                  <li>
                    <span class="bullet-check bullet-check--green">✓</span>
                    <span>{x}</span>
                  </li>
                ))}
              </ul>
            </div>

            {d.excluded.length > 0 && (
              <div class="pkg-card-box pkg-card-box--muted">
                <div class="box-badge-head box-badge-head--muted">
                  <svg viewBox="0 0 20 20" fill="currentColor" width="18" height="18">
                    <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 0 1 1.414 0L10 8.586l4.293-4.293a1 1 0 1 1 1.414 1.414L11.414 10l4.293 4.293a1 1 0 0 1-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 0 1-1.414-1.414L8.586 10 4.293 5.707a1 1 0 0 1 0-1.414Z" clip-rule="evenodd"/>
                  </svg>
                  Belum Termasuk (Excluded)
                </div>
                <ul class="pkg-custom-list">
                  {d.excluded.map((x) => (
                    <li>
                      <span class="bullet-check bullet-check--gray">✕</span>
                      <span>{x}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </section>

        <!-- Section 4: Contoh Rundown Kegiatan Berjam -->
        {d.rundown.length > 0 && (
          <section class="pkg-section-block" aria-labelledby="h-rundown">
            <h2 id="h-rundown" class="pkg-block-title">Susunan Acara (Rundown Kegiatan)</h2>
            <p class="pkg-block-sub">
              Susunan jam di bawah ini merupakan estimasi standar. Jadwal akhir dapat disesuaikan secara fleksibel dengan waktu tiba rombongan Anda dan alokasi durasi yang diinginkan.
            </p>
            <div class="pkg-rundown-timeline">
              {d.rundown.map((r, idx) => (
                <div class="rundown-item">
                  <div class="rundown-time-badge">
                    <span class="rundown-step-num">{idx + 1}</span>
                    <strong>{r.time}</strong>
                  </div>
                  <div class="rundown-desc-card">
                    <p>{r.activity}</p>
                  </div>
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- Section 5: Standar Keamanan & SOP Kesehatan -->
        {d.safety.length > 0 && (
          <section class="pkg-section-block" aria-labelledby="h-aman">
            <h2 id="h-aman" class="pkg-block-title">Standar Keselamatan, Kesehatan, & SOP</h2>
            <div class="pkg-safety-box">
              <div class="safety-box-head">
                <svg viewBox="0 0 20 20" fill="currentColor" width="22" height="22">
                  <path fill-rule="evenodd" d="M9.661 2.237a.531.531 0 0 1 .678 0 11.947 11.947 0 0 0 7.078 2.749 .5.5 0 0 1 .479.425 12.185 12.185 0 0 1-3.236 9.479c-1.892 2.04-4.225 3.51-4.468 3.662a.5.5 0 0 1-.568 0c-.243-.152-2.576-1.622-4.468-3.662a12.185 12.185 0 0 1-3.236-9.479.5.5 0 0 1 .479-.425 11.947 11.947 0 0 0 7.078-2.749Zm.339 2.663a10.457 10.457 0 0 1-5.744-2.18 10.684 10.684 0 0 0 2.808 8.161c1.554 1.676 3.492 2.946 3.936 3.228.444-.282 2.382-1.552 3.936-3.228a10.684 10.684 0 0 0 2.808-8.161 10.457 10.457 0 0 1-5.744 2.18Z" clip-rule="evenodd"/>
                </svg>
                Komitmen Keselamatan Zero Accident Kami
              </div>
              <ul class="pkg-custom-list">
                {d.safety.map((x) => (
                  <li>
                    <span class="bullet-check bullet-check--green">✓</span>
                    <span>{x}</span>
                  </li>
                ))}
              </ul>
            </div>
          </section>
        )}

        <!-- Section 6: Opsi Tambahan / Add-On -->
        {d.addons.length > 0 && (
          <section class="pkg-section-block" aria-labelledby="h-addon">
            <h2 id="h-addon" class="pkg-block-title">Opsi Tambahan & Kustomisasi (Add-On)</h2>
            <div class="pkg-addons-grid">
              {d.addons.map((a) => (
                <div class="pkg-addon-card">
                  <div class="addon-icon">
                    <svg viewBox="0 0 20 20" fill="currentColor" width="20" height="20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm.75-11.25a.75.75 0 0 0-1.5 0v2.5h-2.5a.75.75 0 0 0 0 1.5h2.5v2.5a.75.75 0 0 0 1.5 0v-2.5h2.5a.75.75 0 0 0 0-1.5h-2.5v-2.5Z" clip-rule="evenodd"/>
                    </svg>
                  </div>
                  <span>{a}</span>
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- Section 7: FAQ Khusus Paket Ini -->
        {d.faqs.length > 0 && (
          <section class="pkg-section-block" aria-labelledby="h-faq-paket">
            <h2 id="h-faq-paket" class="pkg-block-title">Pertanyaan Seputar {d.title}</h2>
            <div class="faq-accordion">
              {d.faqs.map((f) => (
                <details class="faq-item">
                  <summary class="faq-question">
                    <span>{f.q}</span>
                    <span class="faq-chevron" aria-hidden="true">+</span>
                  </summary>
                  <div class="faq-answer">
                    <p>{f.a}</p>
                  </div>
                </details>
              ))}
            </div>
          </section>
        )}
      </main>

      <!-- Sidebar Kanan (Rangkuman & CTA) -->
      <aside class="pkg-detail-aside" aria-label="Informasi penting paket dan pemesanan">
        <!-- Panel 1: Rangkuman Paket & Harga -->
        <div class="panel-card side-facts-card">
          <div class="side-price-tag">
            <span class="price-label">Estimasi Biaya Paket</span>
            <div class="price-main">
              {d.priceFrom ? (
                <>
                  <span class="price-val">Mulai {formatRupiah(d.priceFrom)}</span>
                  <span class="price-unit">/{d.priceUnit}</span>
                </>
              ) : (
                <span class="price-val" style="font-size:1.15rem;">Hubungi Kami untuk Penawaran</span>
              )}
            </div>
            {d.priceFrom && d.priceValidUntil && (
              <span class="price-valid">Berlaku s/d {d.priceValidUntil}</span>
            )}
          </div>

          <h3 class="side-card-title">Informasi Penting</h3>
          <dl class="side-facts-list">
            <div>
              <dt>Kategori</dt>
              <dd><span class="badge-inline-green">{categoryLabel[d.category]}</span></dd>
            </div>
            <div>
              <dt>Durasi Acara</dt>
              <dd>{d.duration}</dd>
            </div>
            <div>
              <dt>Kapasitas Peserta</dt>
              <dd>{d.participants ?? 'Disesuaikan dengan rombongan'}</dd>
            </div>
            {d.location && (
              <div>
                <dt>Pilihan Lokasi</dt>
                <dd>{d.location}</dd>
              </div>
            )}
            <div>
              <dt>Trainer / Fasilitator</dt>
              <dd>Tersertifikasi BNSP Resmi</dd>
            </div>
            <div>
              <dt>Format Penawaran</dt>
              <dd>Proposal PDF & Invoice Resmi</dd>
            </div>
            <div>
              <dt>Pembaruan Data</dt>
              <dd>{new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(d.updatedDate)}</dd>
            </div>
          </dl>

          <div style="margin-top:20px;">
            <WhatsAppCTA
              label={`Minta Proposal ${d.title}`}
              message={msg}
              source={`${pkg.id}-sidebar-top`}
            />
          </div>
        </div>

        <!-- Panel 2: Kartu Konsultasi Langsung & Fast Response -->
        <div class="panel-card side-contact-card">
          <div class="side-wa-badge">LAYANAN KONSULTASI CEPAT</div>
          <h3>Butuh Penyesuaian Anggaran & Rundown?</h3>
          <p>
            Diskusikan kebutuhan khusus instansi Anda bersama tim perencana kami. Gratis survei venue, konsultasi konsep, dan pembuatan proposal lengkap.
          </p>
          <div style="margin-top:18px;">
            <WhatsAppCTA
              label="Chat WhatsApp Admin"
              message={msg}
              source={`${pkg.id}-sidebar-consult`}
            />
          </div>
          <small class="side-contact-note">
            Respon Cepat Setiap Hari: 07.30 – 21.00 WIB
          </small>
        </div>

        <!-- Panel 3: Paket Outbound Lainnya -->
        {otherPackages.length > 0 && (
          <div class="panel-card side-others-card">
            <h3 class="side-card-title">Pilihan Paket Lainnya</h3>
            <ul class="other-pkg-list">
              {otherPackages.map((op) => (
                <li>
                  <a href={pkgUrl(op.id)} class="other-pkg-link">
                    <img
                      src={op.data.image ?? '/destinasi/coban-rondo.webp'}
                      alt={op.data.title}
                      class="other-pkg-thumb"
                      width="64"
                      height="46"
                      loading="lazy"
                    />
                    <div>
                      <strong>{op.data.title}</strong>
                      <small>{op.data.priceFrom ? `Mulai ${formatRupiah(op.data.priceFrom)}` : 'Konsultasi'}</small>
                    </div>
                  </a>
                </li>
              ))}
            </ul>
            <a href="/paket/" class="link-arrow" style="display:inline-block; margin-top:14px; font-size:0.9rem;">
              Lihat semua paket outbound →
            </a>
          </div>
        )}
      </aside>
    </div>
  </div>

  <!-- Section Paket Terkait di Bawah -->
  {related.length > 0 && (
    <section class="section" style="background:#f8faf6; border-top:1px solid var(--color-border);" aria-labelledby="h-terkait">
      <div class="container">
        <div class="section-head">
          <h2 id="h-terkait">Paket Pilihan Terkait</h2>
          <a class="link-arrow" href="/paket/">Lihat semua paket</a>
        </div>
        <div class="grid grid--3">
          {related.map((p, i) => (
            <PackageCard pkg={p} index={i + 1} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA Band Konsultasi Full-Width -->
  <CtaBand
    title={`Rencanakan ${d.title} Bersama Kami`}
    text="Dapatkan proposal penawaran resmi, susunan rundown fleksibel, dan rekomendasi venue terbaik di Kota Batu Malang hari ini."
    message={msg}
    label="Konsultasi Paket Sekarang"
    source={`pkg-detail-bottom-${pkg.id}`}
  />
</BaseLayout>

<style>
  /* Layout Dua Kolom Detail Paket */
  .pkg-detail-layout {
    display: grid;
    gap: 40px;
    align-items: start;
  }
  @media (min-width: 992px) {
    .pkg-detail-layout {
      grid-template-columns: minmax(0, 1fr) 360px;
      gap: 48px;
    }
  }

  /* Media Foto Utama */
  .pkg-main-media {
    margin: 0 0 36px 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: #ffffff;
    border: 1px solid var(--color-border);
    box-shadow: 0 4px 20px rgba(24, 34, 48, 0.05);
  }
  .pkg-main-img-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #e2e8f0;
    overflow: hidden;
  }
  .pkg-main-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .pkg-media-badge {
    position: absolute;
    top: 18px;
    left: 18px;
    background: var(--color-primary);
    color: var(--color-ink);
    font-size: 0.8125rem;
    font-weight: 800;
    padding: 6px 14px;
    border-radius: 9999px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
  }
  .pkg-img-caption {
    padding: 12px 20px;
    font-size: 0.875rem;
    color: var(--color-muted);
    font-style: italic;
    background: #fafbf9;
    border-top: 1px solid var(--color-border);
    margin: 0;
    line-height: 1.5;
  }

  /* Section Block & Judul */
  .pkg-section-block {
    margin-bottom: 44px;
  }
  .pkg-block-title {
    font-size: clamp(1.35rem, 2.3vw, 1.8rem);
    color: var(--color-ink);
    margin: 0 0 16px 0;
    padding-bottom: 12px;
    border-bottom: 2px solid var(--color-border);
    position: relative;
  }
  .pkg-block-title::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 60px;
    height: 2px;
    background: var(--color-green);
  }
  .pkg-block-sub {
    font-size: 0.95rem;
    color: var(--color-muted);
    margin: -6px 0 20px 0;
    line-height: 1.6;
  }

  .pkg-text-content {
    font-size: 1.0313rem;
    line-height: 1.8;
    color: var(--color-text);
  }
  .pkg-text-content p {
    margin-bottom: 16px;
  }
  .pkg-text-content h3 {
    font-size: 1.25rem;
    color: var(--color-ink);
    margin: 24px 0 12px 0;
  }

  /* Dua Card Berjajar */
  .pkg-two-cards {
    display: grid;
    gap: 18px;
  }
  @media (min-width: 640px) {
    .pkg-two-cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .pkg-card-box {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 22px;
    box-shadow: 0 2px 10px rgba(24, 34, 48, 0.03);
  }
  .pkg-card-box--green {
    background: #fbfdfa;
    border-color: #d1e7dd;
  }
  .pkg-card-box--muted {
    background: #fdfdfd;
    border-color: var(--color-border);
  }
  .pkg-box-title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1.1rem;
    color: var(--color-ink);
    margin: 0 0 16px 0;
  }
  .icon-accent {
    color: var(--color-green);
  }

  .box-badge-head {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    font-size: 0.95rem;
    padding: 6px 12px;
    border-radius: 6px;
    margin-bottom: 16px;
  }
  .box-badge-head--green {
    background: #e6f4ea;
    color: #137333;
  }
  .box-badge-head--muted {
    background: #f1f3f4;
    color: #5f6368;
  }

  /* Custom List */
  .pkg-custom-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .pkg-custom-list li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-text);
  }
  .bullet-check {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #eef7ee;
    color: var(--color-green);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.75rem;
    margin-top: 1px;
  }
  .bullet-check--green {
    background: #d4edda;
    color: #155724;
  }
  .bullet-check--gray {
    background: #f5f5f5;
    color: #721c24;
  }

  /* Rundown Timeline */
  .pkg-rundown-timeline {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .rundown-item {
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 16px 20px;
    box-shadow: 0 2px 6px rgba(24, 34, 48, 0.02);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  @media (min-width: 600px) {
    .rundown-item {
      flex-direction: row;
      align-items: center;
      gap: 20px;
    }
  }
  .rundown-item:hover {
    border-color: #c4d7c8;
    transform: translateX(4px);
  }
  .rundown-time-badge {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.95rem;
