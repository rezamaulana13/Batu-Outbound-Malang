---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WhatsAppCTA from '../../components/WhatsAppCTA.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import { destinations, destinationUrl } from '../../data/destinations';
import { site, waMessages } from '../../data/site';

export async function getStaticPaths() {
  const paths = destinations.map((dest) => ({
    params: { slug: dest.id },
    props: { dest },
  }));
  const songgoriti = destinations.find((d) => d.id === 'tirta-nirwana-songgoriti');
  if (songgoriti) {
    paths.push({
      params: { slug: 'songgoriti' },
      props: { dest: songgoriti },
    });
  }
  return paths;
}

const { dest } = Astro.props;
const base = Astro.site ?? new URL('https://batuoutboundmalang.example');

const placeSchema = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  name: dest.name,
  description: dest.description,
  url: new URL(destinationUrl(dest.id), base).href,
  address: {
    '@type': 'PostalAddress',
    addressLocality: dest.location,
    addressCountry: 'ID',
  },
};

const otherDestinations = destinations.filter((d) => d.id !== dest.id).slice(0, 4);

const breadcrumbs = [
  { label: 'Beranda', href: '/' },
  { label: 'Destinasi Outbound', href: '/destinasi/' },
  { label: dest.shortName },
];
---

<BaseLayout
  title={`${dest.name}: Lokasi Outbound dan Gathering di Batu Malang | Batu Outbound`}
  description={dest.description}
  path={destinationUrl(dest.id)}
  breadcrumbs={breadcrumbs}
  schema={[placeSchema]}
>
  <!-- Hero Banner: Bersih tanpa badge/kapasitas di atas judul -->
  <section class="page-hero">
    <div class="container">
      <h1>{dest.name}</h1>
      <p class="lead">{dest.tagline}</p>
      <Breadcrumbs items={breadcrumbs} />
      <div class="btn-row" style="margin-top:20px;">
        <WhatsAppCTA
          label={`Konsultasi Outbound di ${dest.shortName}`}
          message={waMessages.dest(dest.name)}
          source={`dest-detail-${dest.id}`}
        />
        <a href="/destinasi/" class="btn btn--secondary">Lihat Destinasi Lain</a>
      </div>
    </div>
  </section>

  <!-- Konten Utama Detail Destinasi -->
  <div class="container" style="padding-top: clamp(44px, 5vw, 68px); padding-bottom: clamp(56px, 6vw, 80px);">
    <div class="dest-detail-layout">
      <!-- Kolom Konten Kiri -->
      <main class="dest-detail-main">
        <!-- Banner Foto Utama & Keterangan Foto (Alt Text / Caption) -->
        <figure class="dest-main-media">
          <div class="dest-main-img-wrap">
            <img
              src={dest.image}
              alt={`Dokumentasi panorama alam dan area kegiatan outbound ${dest.name} di Batu Malang`}
              class="dest-main-img"
              width="900"
              height="500"
            />
            <span class="dest-media-badge">{dest.shortName}</span>
          </div>
          <figcaption class="dest-img-caption">
            Dokumentasi area terbuka dan suasana alam di {dest.name}, Batu Malang
          </figcaption>
        </figure>

        <!-- Section 1: Daya Tarik & Karakteristik Wilayah -->
        <section class="dest-section-block" aria-labelledby="h-daya-tarik">
          <h2 id="h-daya-tarik" class="dest-block-title">Daya Tarik & Karakteristik Wilayah</h2>
          <div class="dest-text-content">
            {dest.overview.map((para) => (
              <p>{para}</p>
            ))}
          </div>
        </section>

        <!-- Section 2: Fasilitas & Karakter Area -->
        <section class="dest-section-block" aria-labelledby="h-fasilitas">
          <h2 id="h-fasilitas" class="dest-block-title">Fasilitas & Karakteristik Area</h2>
          <div class="features-grid">
            {dest.features.map((feat) => (
              <div class="feature-item">
                <div class="feature-check">
                  <svg viewBox="0 0 20 20" fill="currentColor" width="18" height="18">
                    <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd"/>
                  </svg>
                </div>
                <span>{feat}</span>
              </div>
            ))}
          </div>
        </section>

        <!-- Section 3: Aktivitas & Modul Outbound yang Direkomendasikan -->
        <section class="dest-section-block" aria-labelledby="h-aktivitas">
          <h2 id="h-aktivitas" class="dest-block-title">Aktivitas yang Sangat Cocok di Lokasi Ini</h2>
          <div class="activity-cards">
            {dest.suitableActivities.map((act) => (
              <div class="activity-card">
                <span class="activity-bullet">🎯</span>
                <span class="activity-name">{act}</span>
              </div>
            ))}
          </div>
        </section>

        <!-- Section 4: Nilai Tambah & Keunggulan -->
        <section class="dest-section-block" aria-labelledby="h-keunggulan">
          <h2 id="h-keunggulan" class="dest-block-title">Keunggulan Memilih {dest.shortName}</h2>
          <div class="highlights-box">
            {dest.highlights.map((item) => (
              <div class="highlight-item">
                <div class="hl-icon">⭐</div>
                <div class="hl-content">
                  <strong>{item}</strong>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- Section 5: Contoh Rundown Kegiatan di Lokasi Ini -->
        <section class="dest-section-block" aria-labelledby="h-rundown">
          <h2 id="h-rundown" class="dest-block-title">Contoh Estimasi Susunan Acara (Rundown)</h2>
          <p class="meta" style="margin-bottom:20px;">
            Rundown di bawah ini merupakan estimasi alur kegiatan 1 hari (One Day Event) di {dest.shortName} dan dapat disesuaikan sepenuhnya dengan jam tiba serta kebutuhan kelompok Anda.
          </p>
          <div class="timeline-wrap">
            <ul class="dest-timeline">
              {dest.suggestedRundown.map((item) => (
                <li class="timeline-step">
                  <div class="timeline-time">{item.time}</div>
                  <div class="timeline-body">
                    <strong class="timeline-act">{item.activity}</strong>
                    <p class="timeline-desc">{item.desc}</p>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </section>

        <!-- Section 6: Rekomendasi Paket Terkait -->
        <section class="dest-section-block" aria-labelledby="h-paket-rekomendasi">
          <h2 id="h-paket-rekomendasi" class="dest-block-title">Rekomendasi Paket di {dest.shortName}</h2>
          <div class="pkg-rec-grid">
            {dest.recommendedPackages.map((pkg) => (
              <div class="pkg-rec-card">
                <div class="pkg-rec-head">
                  <span class="badge badge--yellow">Paket Populer</span>
                  <h3>
                    <a href={`/paket/${pkg.slug}/`}>{pkg.name}</a>
                  </h3>
                  <div class="pkg-rec-price">{pkg.price}</div>
                </div>
                <p class="pkg-rec-desc">
                  Termasuk instruktur bersertifikasi BNSP, master games, peralatan outbound lengkap, P3K lapangan, dan dokumentasi foto.
                </p>
                <div class="pkg-rec-actions">
                  <a href={`/paket/${pkg.slug}/`} class="btn btn--secondary btn--sm">
                    Detail Paket
                  </a>
                  <WhatsAppCTA
                    label="Pesan Paket Ini"
                    message={`Halo Admin, saya tertarik dengan ${pkg.name} di destinasi ${dest.name}. Boleh minta rincian penawarannya?`}
                    small
                    variant="primary"
                    source={`dest-pkg-${pkg.slug}`}
                  />
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- Section 7: FAQ Khusus Destinasi -->
        <section class="dest-section-block" aria-labelledby="h-faq-dest">
          <h2 id="h-faq-dest" class="dest-block-title">Pertanyaan Umum Seputar {dest.shortName}</h2>
          <div class="faq-accordion">
            {dest.faqs.map((f) => (
              <details class="faq-item">
                <summary class="faq-question">
                  <span>{f.q}</span>
                  <span class="faq-chevron" aria-hidden="true">+</span>
                </summary>
                <div class="faq-answer">
                  <p>{f.a}</p>
                </div>
              </details>
            ))}
          </div>
        </section>
      </main>

      <!-- Sidebar Kanan: Rangkuman & Kontak Cepat -->
      <aside class="dest-detail-aside" aria-label="Ringkasan Lokasi dan Konsultasi">
        <!-- Panel 1: Rangkuman Lokasi -->
        <div class="panel-card side-facts-card">
          <h3 class="side-card-title">Rangkuman Lokasi</h3>
          <dl class="side-facts-list">
            <div>
              <dt>Nama Destinasi</dt>
              <dd>{dest.name}</dd>
            </div>
            <div>
              <dt>Wilayah</dt>
              <dd>{dest.location}</dd>
            </div>
            <div>
              <dt>Kapasitas Peserta</dt>
              <dd><span class="badge-inline-green">{dest.capacity}</span></dd>
            </div>
            <div>
              <dt>Ketinggian Tempat</dt>
              <dd>{dest.elevation}</dd>
            </div>
            <div>
              <dt>Akses Bus Besar</dt>
              <dd>{dest.accessBus}</dd>
            </div>
            <div>
              <dt>Sangat Cocok Untuk</dt>
              <dd>{dest.bestFor.join(', ')}</dd>
            </div>
          </dl>
        </div>

        <!-- Panel 2: Kartu Kontak Konsultasi Cepat -->
        <div class="panel-card side-contact-card">
          <div class="side-wa-badge">KONSULTASI GRATIS</div>
          <h3>Rencanakan Outbound di {dest.shortName}</h3>
          <p>
            Dapatkan estimasi biaya, ketersediaan tanggal, dan susunan rundown resmi dari tim konsultan kami.
          </p>
          <div style="margin-top:20px;">
            <WhatsAppCTA
              label="Chat WhatsApp Admin"
              message={waMessages.dest(dest.name)}
              source={`aside-${dest.id}`}
            />
          </div>
          <small class="side-contact-note">
            Respon Cepat Setiap Hari: 07.30 – 21.00 WIB
          </small>
        </div>

        <!-- Panel 3: Destinasi Pilihan Lainnya -->
        <div class="panel-card side-others-card">
          <h3 class="side-card-title">Destinasi Lain di Batu</h3>
          <ul class="other-dest-list">
            {otherDestinations.map((od) => (
              <li>
                <a href={destinationUrl(od.id)} class="other-dest-link">
                  <img src={od.image} alt={od.name} class="other-dest-thumb" width="60" height="42" loading="lazy" />
                  <div>
                    <strong>{od.name}</strong>
                    <small>{od.capacity}</small>
                  </div>
                </a>
              </li>
            ))}
          </ul>
          <a href="/destinasi/" class="link-arrow" style="display:inline-block; margin-top:14px; font-size:0.9rem;">
            Lihat semua 9 destinasi →
          </a>
        </div>
      </aside>
    </div>
  </div>

  <!-- CTA Band di Bawah -->
  <CtaBand
    title={`Siap Menyelenggarakan Outbound di ${dest.shortName}?`}
    subtitle="Konsultasikan rencana kegiatan gathering dan outbound tim Anda. Kami siap memberikan opsi paket terpadu sesuai kebutuhan dan anggaran Anda."
    source={`dest-bottom-${dest.id}`}
  />
</BaseLayout>

<style>
  .dest-detail-layout {
    display: grid;
    gap: 40px;
    align-items: start;
  }
  @media (min-width: 1024px) {
    .dest-detail-layout {
      grid-template-columns: 1fr 350px;
      gap: 52px;
    }
  }

  /* Media Utama & Quick Stats */
  .dest-main-media {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 6px 24px rgba(24, 34, 48, 0.06);
    margin: 0 0 40px 0;
  }
  .dest-main-img-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #e2e8f0;
    overflow: hidden;
  }
  .dest-main-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .dest-media-badge {
    position: absolute;
    top: 18px;
    left: 18px;
    background: var(--color-primary);
    color: var(--color-ink);
    font-size: 0.8125rem;
    font-weight: 800;
    padding: 6px 14px;
    border-radius: 9999px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
  }
  .dest-img-caption {
    padding: 12px 20px;
    font-size: 0.875rem;
    color: var(--color-muted);
    font-style: italic;
    background: #fafbf9;
    border-top: 1px solid var(--color-border);
    margin: 0;
    line-height: 1.5;
  }

  /* Section Block */
  .dest-section-block {
    margin-bottom: 44px;
  }
  .dest-block-title {
    font-size: clamp(1.4rem, 2.4vw, 1.85rem);
    color: var(--color-ink);
    margin: 0 0 18px 0;
    padding-bottom: 12px;
    border-bottom: 2px solid var(--color-border);
    position: relative;
  }
  .dest-block-title::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 60px;
    height: 2px;
    background: var(--color-green);
  }

  .dest-text-content p {
    font-size: 1.0313rem;
    line-height: 1.8;
    color: var(--color-text);
    margin-bottom: 16px;
  }

  /* Features Grid */
  .features-grid {
    display: grid;
    gap: 14px;
  }
  @media (min-width: 640px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .feature-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    background: #ffffff;
    border: 1px solid var(--color-border);
    padding: 14px 16px;
    border-radius: var(--radius-md);
    box-shadow: 0 2px 8px rgba(24, 34, 48, 0.03);
  }
  .feature-check {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--color-green-soft);
    color: var(--color-green);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 1px;
  }
  .feature-item span {
    font-size: 0.9375rem;
    color: var(--color-ink);
    font-weight: 500;
    line-height: 1.5;
  }

  /* Activities */
  .activity-cards {
    display: grid;
    gap: 12px;
  }
  @media (min-width: 600px) {
    .activity-cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .activity-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    background: #f4f8f5;
    border: 1px solid #d8ebd9;
    border-radius: var(--radius-md);
  }
  .activity-bullet {
    font-size: 1.25rem;
  }
  .activity-name {
    font-size: 0.9688rem;
    font-weight: 700;
    color: #143e2b;
  }

  /* Highlights Box */
  .highlights-box {
    display: grid;
    gap: 14px;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 22px 20px;
    box-shadow: 0 4px 14px rgba(24, 34, 48, 0.04);
  }
  .highlight-item {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .hl-icon {
    font-size: 1.2rem;
  }
  .hl-content strong {
    font-size: 0.9688rem;
    color: var(--color-ink);
    font-weight: 600;
  }

  /* Timeline */
  .timeline-wrap {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 28px 24px;
    box-shadow: 0 4px 16px rgba(24, 34, 48, 0.04);
  }
  .dest-timeline {
    list-style: none;
    padding: 0;
    margin: 0;
    position: relative;
    border-left: 2px dashed var(--color-green);
    margin-left: 10px;
  }
  .timeline-step {
    position: relative;
    padding-left: 28px;
    padding-bottom: 24px;
  }
  .timeline-step:last-child {
    padding-bottom: 0;
  }
  .timeline-step::before {
    content: '';
    position: absolute;
    left: -7px;
    top: 4px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--color-green);
    box-shadow: 0 0 0 4px var(--color-green-soft);
  }
  .timeline-time {
    font-size: 0.8125rem;
    font-weight: 800;
    color: var(--color-green);
    background: var(--color-green-soft);
    display: inline-block;
    padding: 2px 8px;
    border-radius: 4px;
    margin-bottom: 4px;
  }
  .timeline-act {
    display: block;
    font-size: 1.0313rem;
    color: var(--color-ink);
    margin-bottom: 4px;
  }
  .timeline-desc {
    font-size: 0.9063rem;
    color: var(--color-muted);
    margin: 0;
    line-height: 1.5;
  }

  /* Package Cards */
  .pkg-rec-grid {
    display: grid;
    gap: 20px;
  }
  @media (min-width: 680px) {
    .pkg-rec-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .pkg-rec-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 24px;
    box-shadow: 0 4px 16px rgba(24, 34, 48, 0.06);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .pkg-rec-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 24px rgba(24, 34, 48, 0.1);
  }
  .pkg-rec-head h3 {
    font-size: 1.2rem;
    margin: 8px 0 6px 0;
  }
  .pkg-rec-head h3 a {
    color: var(--color-ink);
    text-decoration: none;
  }
  .pkg-rec-head h3 a:hover {
    color: var(--color-green);
  }
  .pkg-rec-price {
    font-size: 1rem;
    font-weight: 800;
    color: #143e2b;
    margin-bottom: 12px;
  }
  .pkg-rec-desc {
    font-size: 0.875rem;
    color: var(--color-muted);
    line-height: 1.55;
    margin-bottom: 18px;
    flex: 1;
  }
  .pkg-rec-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    border-top: 1px solid var(--color-border);
    padding-top: 14px;
  }

  /* FAQ Accordion */
  .faq-accordion {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .faq-item {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .faq-question {
    padding: 16px 20px;
    font-size: 0.9688rem;
    font-weight: 700;
    color: var(--color-ink);
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #ffffff;
    user-select: none;
  }
  .faq-question::-webkit-details-marker {
    display: none;
  }
  .faq-chevron {
    font-size: 1.3rem;
    font-weight: 400;
    color: var(--color-muted);
    transition: transform 0.2s ease;
  }
  .faq-item[open] .faq-chevron {
    transform: rotate(45deg);
  }
  .faq-answer {
    padding: 0 20px 18px 20px;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-text);
  }
  .faq-answer p {
    margin: 0;
  }

  /* Sidebar */
  .dest-detail-aside {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  @media (min-width: 1024px) {
    .dest-detail-aside {
      position: sticky;
      top: calc(var(--header-h) + 20px);
    }
  }

  .panel-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 24px 22px;
    box-shadow: 0 4px 18px rgba(24, 34, 48, 0.05);
  }
  .side-card-title {
    font-size: 1.15rem;
    color: var(--color-ink);
    margin: 0 0 16px 0;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--color-border);
  }

  .side-facts-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 0;
  }
  .side-facts-list dt {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 2px;
  }
  .side-facts-list dd {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-ink);
    line-height: 1.4;
  }
  .badge-inline-green {
    display: inline-block;
    background: var(--color-green-soft);
    color: var(--color-green);
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 0.8125rem;
  }

  /* Side Contact Card */
  .side-contact-card {
    background: #143e2b;
    color: #ffffff;
    border: 1px solid #1a4d36;
  }
  .side-wa-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 800;
    padding: 4px 10px;
    background: rgba(244, 180, 0, 0.2);
    color: var(--color-primary);
    border-radius: 9999px;
    margin-bottom: 10px;
  }
  .side-contact-card h3 {
    font-size: 1.25rem;
    color: #ffffff;
    margin: 0 0 10px 0;
  }
  .side-contact-card p {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.55;
    margin: 0;
  }
  .side-contact-note {
    display: block;
    margin-top: 14px;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.7);
    text-align: center;
  }

  /* Other Destinations */
  .other-dest-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .other-dest-link {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
